 export async function getCopilotToken(
   ctx: AccountContext,
   signal?: AbortSignal,
 ): Promise<GetCopilotTokenResponse> {
+  if (usesGitHubCliAuth()) {
+    if (!ctx.githubToken)
+      throw new Error('GitHub CLI auth requires an existing GitHub OAuth token')
+    // The Copilot CLI integration accepts GitHub OAuth directly. Validate it
+    // against the account's Copilot API; no new token or OAuth grant is created.
+    const validation = await fetchCopilot(`${copilotBaseUrl(ctx)}/models`, {
+      headers: copilotHeaders(ctx),
+      signal,
+    })
+    if (!validation.ok)
+      throw new HTTPError('Failed to validate direct Copilot CLI authentication', validation)
+    await validation.arrayBuffer()
+    // These are local revalidation deadlines, not the OAuth token's expiry.
+    return {
+      token: ctx.githubToken,
+      expires_at: Math.floor(Date.now() / 1000) + 3600,
+      refresh_in: 1800,
+    }
+  }
