+// Opt-in compatibility path for an existing Copilot CLI OAuth login.
+// Keep the published editor-token exchange as the default.
+export function usesGitHubCliAuth(): boolean {
+  const mode = process.env.COPILOT_PROXY_AUTH_MODE ?? 'exchange'
+  if (mode !== 'exchange' && mode !== 'github-cli')
+    throw new Error('COPILOT_PROXY_AUTH_MODE must be exchange or github-cli')
+  return mode === 'github-cli'
