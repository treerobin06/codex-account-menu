diff --git a/tests/github-cli-auth.test.ts b/tests/github-cli-auth.test.ts
new file mode 100644
index 0000000..7051154
--- /dev/null
+++ b/tests/github-cli-auth.test.ts
@@ -0,0 +1,59 @@
+import { afterEach, describe, expect, mock, test } from 'bun:test'
+
+import { createAccountContext } from '~/lib/account/context'
+import { copilotHeaders, usesGitHubCliAuth } from '~/lib/api-config'
+import { getCopilotToken } from '~/services/github/get-copilot-token'
+
+const originalMode = process.env.COPILOT_PROXY_AUTH_MODE
+const originalFetch = globalThis.fetch
+afterEach(() => {
+  if (originalMode === undefined)
+    delete process.env.COPILOT_PROXY_AUTH_MODE
+  else
+    process.env.COPILOT_PROXY_AUTH_MODE = originalMode
+  globalThis.fetch = originalFetch
+})
+
+function account() {
+  const ctx = createAccountContext({ accountType: 'enterprise' })
+  ctx.githubToken = 'test-github-oauth'
+  ctx.copilotToken = 'test-exchanged-token'
+  return ctx
+}
+
+describe('opt-in GitHub CLI OAuth authentication', () => {
+  test('preserves the upstream default', () => {
+    delete process.env.COPILOT_PROXY_AUTH_MODE
+    expect(usesGitHubCliAuth()).toBe(false)
+    expect(copilotHeaders(account()).Authorization).toBe('Bearer test-exchanged-token')
+    expect(copilotHeaders(account())['copilot-integration-id']).toBe('vscode-chat')
+  })
+
+  test('rejects a misspelled authentication mode', () => {
+    process.env.COPILOT_PROXY_AUTH_MODE = 'invalid'
+    expect(usesGitHubCliAuth).toThrow('must be exchange or github-cli')
+  })
+
+  test('validates the existing credential without exchanging or replacing it', async () => {
+    process.env.COPILOT_PROXY_AUTH_MODE = 'github-cli'
+    const calls: string[] = []
+    globalThis.fetch = mock(async (input: Parameters<typeof fetch>[0], init?: RequestInit) => {
+      calls.push(String(input))
+      const headers = new Headers(init?.headers)
+      expect(headers.get('authorization')).toBe('Bearer test-github-oauth')
+      expect(headers.get('copilot-integration-id')).toBe('copilot-developer-cli')
+      expect(headers.has('editor-version')).toBe(false)
+      return Response.json({ data: [] })
+    }) as unknown as typeof fetch
+    const result = await getCopilotToken(account())
+    expect(result.token).toBe('test-github-oauth')
+    expect(result.refresh_in).toBe(1800)
+    expect(calls).toEqual(['https://api.enterprise.githubcopilot.com/models'])
+  })
+
+  test('propagates upstream denial instead of claiming authentication success', async () => {
+    process.env.COPILOT_PROXY_AUTH_MODE = 'github-cli'
+    globalThis.fetch = mock(async () => new Response('denied', { status: 403 })) as unknown as typeof fetch
+    await expect(getCopilotToken(account())).rejects.toThrow('Failed to validate')
+  })
+})
